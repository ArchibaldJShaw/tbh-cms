{
  "name": "tbh-cms",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build --no-optimization || echo 'Build failed, continuing...'",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "NODE_ENV=development strapi start",
    "develop": "NODE_ENV=development strapi start",
    "start": "NODE_ENV=development strapi build && NODE_ENV=development strapi start",
    "prebuild": "strapi build || echo 'Build failed, using existing dist'",
    "start:prod": "NODE_ENV=production strapi start",
    "strapi": "strapi",
    "postinstall": "npm install --platform=linux --arch=x64 sharp",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry"
  },
  "dependencies": {
    "@strapi/plugin-cloud": "5.33.0",
    "@strapi/plugin-users-permissions": "5.33.0",
    "@strapi/strapi": "5.33.0",
    "better-sqlite3": "12.4.1",
    "pg": "^8.16.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "sharp": "^0.34.5",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0",
    "@swc/core-linux-x64-gnu": "^1.15.7",
    "@swc/core-linux-x64-musl": "^1.15.7",
    "sharp-linux-x64": "^0.33.5"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "15f9cb5c-0bd9-40d4-aadb-2ea4285fb7b2",
    "installId": "f3d4cc2db9254de7ee076c9f2115d4189507b6dd4c9ead7015cdebd0362827e2"
  }
}
