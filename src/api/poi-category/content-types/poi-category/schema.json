{
  "kind": "collectionType",
  "collectionName": "poi_categories",
  "info": {
    "singularName": "poi-category",
    "pluralName": "poi-categories",
    "displayName": "POI Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "icon": {
      "type": "string"
    },
    "iconImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "color": {
      "type": "string",
      "default": "#8b7355"
    },
    "language": {
      "type": "enumeration",
      "enum": ["ru", "en"],
      "default": "ru"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
