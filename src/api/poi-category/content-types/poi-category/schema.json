{
  "kind": "collectionType",
  "collectionName": "poi_categories",
  "info": {
    "singularName": "poi-category",
    "pluralName": "poi-categories",
    "displayName": "POI Category",
    "description": "Categories for Points of Interest on the map"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "icon": {
      "type": "string",
      "required": false
    },
    "iconImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "color": {
      "type": "string",
      "required": true,
      "default": "#8b7355"
    },
    "language": {
      "type": "enumeration",
      "enum": ["ru", "en"],
      "default": "ru",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "points_of_interest": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::point-of-interest.point-of-interest",
      "mappedBy": "category"
    }
  }
}
