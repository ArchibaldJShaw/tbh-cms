{
  "kind": "collectionType",
  "collectionName": "map_zones",
  "info": {
    "singularName": "map-zone",
    "pluralName": "map-zones",
    "displayName": "Map Zone"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "coordinates": {
      "type": "json",
      "required": true
    },
    "color": {
      "type": "string",
      "default": "#8b7355"
    },
    "fillOpacity": {
      "type": "decimal",
      "default": 0.3
    },
    "language": {
      "type": "enumeration",
      "enum": ["ru", "en"],
      "default": "ru"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
