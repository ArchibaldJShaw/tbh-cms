{
  "kind": "collectionType",
  "collectionName": "points_of_interest",
  "info": {
    "singularName": "point-of-interest",
    "pluralName": "points-of-interest",
    "displayName": "Point of Interest"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "x_coordinate": {
      "type": "decimal",
      "required": true
    },
    "y_coordinate": {
      "type": "decimal",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::poi-category.poi-category"
    },
    "language": {
      "type": "enumeration",
      "enum": ["ru", "en"],
      "default": "ru"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    }
  }
}
